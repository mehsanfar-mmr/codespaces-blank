class LiveReal(LiveVirtual):
    def __init__(self, exchange, symbols, cfg=CONFIG):
        super().__init__(exchange, symbols, cfg)

        self.state_path = os.path.join(cfg.get('log_dir'), 'open_positions.json')
        ensure_dirs()
        self._load_state()

    # ------------------------------------------------------------------
    # ---------------------- Persistence Layer --------------------------
    # ------------------------------------------------------------------
    def _save_state(self):
        try:
            with open(self.state_path, 'w', encoding='utf-8') as f:
                json.dump(self.open_positions, f, indent=2)
        except Exception as e:
            log_print(f"[STATE ERROR] save failed: {e}")

    def _load_state(self):
        if not os.path.exists(self.state_path):
            self.open_positions = {}
            return
        try:
            with open(self.state_path, 'r', encoding='utf-8') as f:
                self.open_positions = json.load(f)
            log_print(f"[STATE] Restored {len(self.open_positions)} open positions.")
        except Exception as e:
            log_print(f"[STATE ERROR] load failed: {e}")
            self.open_positions = {}

    def _clear_position(self, symbol):
        if symbol in self.open_positions:
            del self.open_positions[symbol]
            self._save_state()

    # ------------------------------------------------------------------
    # --------------------- Exchange Helpers ----------------------------
    # ------------------------------------------------------------------
    def _get_current_price(self, symbol, side='buy'):
        try:
            t = self.exchange.fetch_ticker(symbol)
            if side == 'buy':
                return float(t.get('ask') or t.get('last'))
            return float(t.get('bid') or t.get('last'))
        except Exception:
            return None

    def _market_info(self, symbol):
        markets = self.exchange.load_markets()
        m = markets.get(symbol, {})
        prec_amount = m.get('precision', {}).get('amount', 8)
        min_amount = m.get('limits', {}).get('amount', {}).get('min')
        min_cost = m.get('limits', {}).get('cost', {}).get('min')
        return prec_amount, min_amount, min_cost

    def _round_amount(self, value, precision):
        factor = 10 ** int(precision)
        return math.floor(float(value) * factor) / factor

    # ------------------------------------------------------------------
    # --------------------- Order Execution -----------------------------
    # ------------------------------------------------------------------
    def _safe_market_buy(self, symbol, cost):
        if not self.cfg.get('real_trading_enabled', 0):
            price = self._get_current_price(symbol, 'buy')
            return {'filled': cost / price, 'average': price}

        try:
            return self.exchange.createMarketBuyOrderWithCost(symbol, cost)
        except Exception as e:
            log_print(f"[BUY FAILED] {symbol} cost={cost:.4f} | {e}")
            return None

    def _safe_market_sell(self, symbol, qty):
        if not self.cfg.get('real_trading_enabled', 0):
            price = self._get_current_price(symbol, 'sell')
            return {'filled': qty, 'average': price}

        try:
            return self.exchange.create_market_sell_order(symbol, qty)
        except Exception as e:
            log_print(f"[SELL FAILED] {symbol} qty={qty:.6f} | {e}")
            return None

    # ------------------------------------------------------------------
    # --------------------------- Main Loop -----------------------------
    # ------------------------------------------------------------------
    def run_loop(self):
        tf_sec = timeframe_to_seconds(self.cfg.get('timeframe', '4h'))
        log_print(f"=== Live Real (XT Safe) Started {ts_now()} ===")

        while True:
            try:
                self._check_status_logging()

                for symbol in self.symbols:
                    df = self.fetch_df(symbol)
                    if df is None or len(df) < 5:
                        continue

                    i = len(df) - 2
                    row = df.iloc[i]

                    # ================= ENTRY =================
                    if symbol not in self.open_positions:
                        sig = generate_signal_row(df, i, self.cfg)
                        if not sig['buy']:
                            continue

                        entry_price = float(row['close'])
                        sl, tp = calc_sl_tp_from_atr(entry_price, row['atr'], self.cfg)
                        qty = position_size(self.equity, entry_price, sl, self.cfg)
                        if qty <= 0:
                            continue

                        prec_amount, min_amount, min_cost = self._market_info(symbol)
                        price = self._get_current_price(symbol, 'buy')
                        if not price:
                            continue

                        qty = self._round_amount(qty, prec_amount)
                        cost = float(qty * price)

                        if min_amount and qty < min_amount:
                            continue
                        if min_cost and cost < min_cost:
                            continue

                        order = self._safe_market_buy(symbol, cost)
                        if not order:
                            continue  # ⛔ skip this candle – no retry loop

                        avg_price = float(order.get('average') or price)
                        filled_qty = float(order.get('filled', qty))

                        sl, tp = calc_sl_tp_from_atr(avg_price, row['atr'], self.cfg)

                        self.open_positions[symbol] = {
                            'symbol': symbol,
                            'entry': avg_price,
                            'sl': sl,
                            'sl_init': sl,
                            'tp': tp,
                            'qty': filled_qty,
                            'entry_time': ts_now(fmt_local=True)
                        }
                        self._save_state()
                        log_print(f"[ENTRY] {symbol} @ {avg_price:.6f} qty {filled_qty:.6f}")

                    # ================= EXIT =================
                    if symbol in self.open_positions:
                        pos = self.open_positions[symbol]
                        last = df.iloc[-1]

                        if last['low'] <= pos['sl']:
                            exit_price = pos['sl']
                            reason = 'SL'
                        elif last['high'] >= pos['tp']:
                            exit_price = pos['tp']
                            reason = 'TP'
                        else:
                            continue

                        order = self._safe_market_sell(symbol, pos['qty'])
                        if not order:
                            continue

                        exec_price = float(order.get('average') or exit_price)
                        net_pct = apply_fees_and_slippage(pos['entry'], exec_price, self.cfg)
                        pnl = pos['qty'] * pos['entry'] * (net_pct / 100.0)
                        self.equity += pnl

                        log_print(f"[EXIT] {symbol} {reason} pnl {pnl:.2f} eq {self.equity:.2f}")
                        self.log_trade({
                            'symbol': symbol,
                            'entry': pos['entry'],
                            'exit': exec_price,
                            'reason': reason,
                            'qty': pos['qty'],
                            'net_pct': net_pct,
                            'net_usd': pnl,
                            'equity': self.equity
                        })

                        self._clear_position(symbol)

                time.sleep(20)

            except Exception as e:
                log_print(f"[LIVE REAL ERROR] {e}")
                time.sleep(5)


