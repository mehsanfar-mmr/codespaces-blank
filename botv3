def load_config(path=CONFIG_PATH):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            cfg = json.load(f)
    except Exception as e:
        print(f"[CONFIG] Could not load {path}: {e} — using DEFAULT_CONFIG.")
        cfg = {}
    merged = DEFAULT_CONFIG.copy()
    merged.update(cfg)
    return merged

