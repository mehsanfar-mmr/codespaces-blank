def build_exchange(cfg=CONFIG):
    params = {
        'enableRateLimit': True,
        'options': {'defaultType': 'spot', 'fetchMarkets': True}
    }
    api_key = cfg.get('access_id') or os.environ.get('EXCHANGE_API_KEY')
    secret = cfg.get('secret_key') or os.environ.get('EXCHANGE_SECRET')
    if api_key and secret:
        params['apiKey'] = api_key
        params['secret'] = secret

    ex_name = cfg.get('exchange', 'xt').lower()
    if hasattr(ccxt, ex_name):
        return getattr(ccxt, ex_name)(params)
    else:
        # fallback: try direct attribute, then construct xt
        try:
            return ccxt.xt(params)
        except Exception:
            return getattr(ccxt, ex_name)(params)

