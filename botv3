class LiveVirtual:
    def __init__(self, exchange, symbols, cfg=CONFIG):
        self.exchange = exchange
        self.symbols = symbols
        self.cfg = cfg
        self.open_positions = {}
        self.equity = cfg.get('equity_start', 1000.0)
        self.log_path = os.path.join(cfg.get('log_dir'), 'live_trades.csv')
        self.last_status_log_time = datetime.now(timezone.utc)
        self.last_trade_time = None

    def fetch_df(self, symbol, limit=1000):
        try:
            df = fetch_ohlcv_long(
                self.exchange, symbol, self.cfg.get('timeframe', '4h'),
                days=30,
                batch_limit=limit
            )
        except Exception as e:
            log_print(f"[LIVE] Fetch error {symbol}: {e}")
            return None
        
        if df is None or df.empty:
            return None
        df = calculate_heikin_ashi(df) 
        df = indicators(df, self.cfg)
        return df

    def ticker_spread_ok(self, symbol):
        try:
            t = self.exchange.fetch_ticker(symbol)
            bid = t.get('bid')
            ask = t.get('ask')
            if not bid or not ask:
                return False
            mid = (bid + ask) / 2.0
            spread_pct = ((ask - bid) / mid) * 100.0
            return spread_pct <= self.cfg.get('max_spread_pct', 0.2)
        except Exception:
            return False

    def log_trade(self, trade: dict):
        ensure_dirs()
        path = self.log_path
        df = pd.DataFrame([trade])
        if not os.path.exists(path):
            df.to_csv(path, index=False)
        else:
            df.to_csv(path, mode='a', header=False, index=False)

    def _check_status_logging(self):
        now = datetime.now(timezone.utc)
        time_since_last_status = (now - self.last_status_log_time).total_seconds()
        
        if (self.last_trade_time is None or (now - self.last_trade_time).total_seconds() >= 6 * 3600):
            if time_since_last_status >= 6 * 3600:
                log_print(f"[STATUS] No entry signal triggered in last 6h — system running normally. ({ts_now()})")
                self.last_status_log_time = now

    def run_loop(self):
        tf_sec = timeframe_to_seconds(self.cfg.get('timeframe', '4h'))
        log_print(f"=== Live Virtual Started ({ts_now()}) ===")
        while True:
            try:
                self._check_status_logging()

                for symbol in self.symbols:
                    df = self.fetch_df(symbol)
                    if df is None or len(df) < 3: continue

                    recent_qv = df['quote_vol_ma'].dropna().tail(50)
                    if recent_qv.empty or recent_qv.median() < self.cfg.get('min_quote_volume_5m', 30000): continue
                    if not self.ticker_spread_ok(symbol): continue

                    i = len(df) - 2
                    row = df.iloc[i]
                    latest_candle = df.iloc[-1]

                    if symbol in self.open_positions:
                        pos = self.open_positions[symbol]
                        
                        current_price = latest_candle['close']
                        current_high = latest_candle['high']
                        current_low = latest_candle['low']
                        
                        rr_denom = (pos['entry'] - pos['sl_init'])
                        rr_now = (current_price - pos['entry']) / rr_denom if rr_denom > 0 else 0.0

                        if rr_now >= self.cfg.get('breakeven_rr') and pos.get('sl', pos['sl_init']) < pos['entry']:
                            pos['sl'] = pos['entry']
                        if rr_now >= self.cfg.get('trail_start_rr'):
                            trail_sl = current_price - self.cfg.get('trail_atr_mult', 1.0) * row['atr']
                            pos['sl'] = max(pos.get('sl', pos['sl_init']), trail_sl)

                        exit_reason = None
                        exit_price = None
                        if current_low <= pos['sl']:
                            exit_reason = 'SL'
                            exit_price = pos['sl']
                        elif current_high >= pos['tp']:
                            exit_reason = 'TP'
                            exit_price = pos['tp']
                        
                        if (not exit_reason and 
                            self.cfg.get('enable_partial_tp', True) and 
                            not pos.get('partial_tp_taken', False)):
                            
                            partial_rr = float(self.cfg.get('partial_tp_rr', 1.2))
                            partial_price = pos['entry'] + partial_rr * (pos['entry'] - pos['sl_init'])
                            
                            if current_high >= partial_price:
                                part_pct = float(self.cfg.get('partial_tp_pct', 0.5))
                                part_qty = pos['qty'] * part_pct
                                if part_qty > 0:
                                    net_pct_part = apply_fees_and_slippage(pos['entry'], partial_price, self.cfg)
                                    pnl_usd_part = part_qty * pos['entry'] * (net_pct_part / 100.0)
                                    self.equity += pnl_usd_part
                                    
                                    log_print(f"[EXIT] {symbol} TP_partial | entry {pos['entry']:.4f} exit {partial_price:.4f} net% {net_pct_part:.2f} eq {self.equity:.2f}")
                                    self.log_trade({
                                        'symbol': symbol,
                                        'entry_time': pos['entry_time'],
                                        'entry': float(pos['entry']),
                                        'exit_time': latest_candle.name.strftime('%m/%d/%Y %I:%M:%S %p'),
                                        'exit': float(partial_price),
                                        'reason': 'TP_partial',
                                        'qty': float(part_qty),
                                        'net_pct': float(net_pct_part),
                                        'net_usd': float(pnl_usd_part),
                                        'equity': float(self.equity)
                                    })
                                    pos['qty'] = max(pos['qty'] - part_qty, 0.0)
                                    pos['sl'] = max(pos.get('sl', pos['sl_init']), pos['entry'])
                                    pos['partial_tp_taken'] = True
                                    self.last_trade_time = datetime.now(timezone.utc)

                        if exit_reason:
                            net_pct = apply_fees_and_slippage(pos['entry'], exit_price, self.cfg)
                            pnl_usd = pos['qty'] * pos['entry'] * (net_pct / 100.0)
                            self.equity += pnl_usd
                            
                            final_reason = exit_reason
                            if exit_reason == 'SL':
                                if exit_price > pos['entry']: final_reason = 'Trail_SL'
                                elif exit_price == pos['entry']: final_reason = 'BE_SL'
                                
                            log_print(f"[EXIT] {symbol} {final_reason} | entry {pos['entry']:.4f} exit {exit_price:.4f} net% {net_pct:.2f} eq {self.equity:.2f}")
                            self.log_trade({
                                'symbol': symbol,
                                'entry_time': pos['entry_time'],
                                'entry': float(pos['entry']),
                                'exit_time': latest_candle.name.strftime('%m/%d/%Y %I:%M:%S %p'),
                                'exit': float(exit_price),
                                'reason': final_reason,
                                'qty': float(pos['qty']),
                                'net_pct': float(net_pct),
                                'net_usd': float(pnl_usd),
                                'equity': float(self.equity)
                            })
                            del self.open_positions[symbol]
                            self.last_trade_time = datetime.now(timezone.utc)

                    if symbol not in self.open_positions:
                        sig = generate_signal_row(df, i, self.cfg)
                        if sig['buy'] \
                           and (row['atr_pct'] > self.cfg.get('min_atr_pct', 0.35)) \
                           and (row['volume'] > row['avg_volume'] * 1.2):
                            
                            entry = float(latest_candle['open']) 
                            sl, tp = calc_sl_tp_from_atr(entry, float(row['atr']), self.cfg)
                            qty = position_size(self.equity, entry, sl, self.cfg)

                            if qty > 0 and self.cfg.get('trading_enabled', 1):
                                self.open_positions[symbol] = {
                                    'symbol': symbol,
                                    'entry_time': latest_candle.name.strftime('%m/%d/%Y %I:%M:%S %p'),
                                    'entry': entry,
                                    'sl': float(sl),
                                    'sl_init': float(sl),
                                    'tp': float(tp),
                                    'qty': float(qty),
                                    'reason': sig['reason'],
                                }
                                log_print(f"[ENTRY] {symbol} {sig['reason']} | entry {entry:.4f} at {self.open_positions[symbol]['entry_time']} sl {sl:.4f} tp {tp:.4f} qty {qty:.6f}")
                                self.last_trade_time = datetime.now(timezone.utc)
                            elif not self.cfg.get('trading_enabled', 1):
                                log_print(f"[LIVE] Trading disabled (trading_enabled=0) — not opening {symbol}.")

                sleep_until_next_candle(tf_seconds=tf_sec, offset=self.cfg.get('sleep_offset_sec', 2))

            except Exception as e:
                log_print(f"[LIVE ERROR] {e}")
                time.sleep(5)

